Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si la petición apunta a un archivo o carpeta real, servirlo directamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Redirigir la raíz a public/
    RewriteRule ^$ public/ [L]

    # Reenviar cualquier petición que no empiece por public/ hacia public/
    RewriteRule ^((?!public/).*)$ public/$1 [L,QSA]
</IfModule>

# Bloquear acceso directo a archivos dotfiles (.env, .git, etc.)
<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>
