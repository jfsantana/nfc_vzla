{
    "name": "app/sistema-nfc",
    "description": "Sistema MVC moderno, seguro y escalable para PHP 8.3",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
